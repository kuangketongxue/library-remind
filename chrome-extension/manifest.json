{
  "manifest_version": 3,
  "name": "精力管理 — 久坐提醒 & 护眼",
  "description": "60分钟学习循环 + 20-20-20护眼提醒 + 白噪音 + AI报告，帮你科学管理学习节奏",
  "version": "1.1.0",
  "permissions": [
    "alarms",
    "storage",
    "notifications"
  ],
  "commands": {
    "toggle-pause": {
      "suggested_key": { "default": "Ctrl+Alt+P" },
      "description": "暂停/继续计时器"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "web_accessible_resources": [{
    "resources": ["review.html", "trends.html", "eye-rest.html", "reports.html", "achievements.html"],
    "matches": ["<all_urls>"]
  }],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
